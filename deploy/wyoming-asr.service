[Unit]
Description=Wyoming ASR - Multi-engine Speech-to-Text
Documentation=https://github.com/hass-cortex/wyoming-asr
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wyoming-asr
Group=wyoming-asr
ExecStart=/usr/local/bin/wyoming-asr \
    --data-dir /var/lib/wyoming-asr \
    --static-dir /usr/local/share/wyoming-asr/web
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/wyoming-asr

# Environment
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
