#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Cortex STT Server — Init oneshot
# Dev-override + dirs + permissions
# ==============================================================================

DEV_DIR="/share/.dev/cortex-stt-server"

if [ -d "${DEV_DIR}" ]; then
    if [ -f "${DEV_DIR}/cortex-stt-server" ]; then
        bashio::log.warning "[DEV MODE] Loading binary from ${DEV_DIR}"
        cp "${DEV_DIR}/cortex-stt-server" /app/cortex-stt-server
        chmod +x /app/cortex-stt-server
    fi

    if [ -d "${DEV_DIR}/web/dist" ]; then
        mkdir -p /app/web
        rm -rf /app/web/dist
        cp -r "${DEV_DIR}/web/dist" /app/web/dist
    fi
else
    bashio::log.info "Using baked-in binary at /app/cortex-stt-server"
fi

# Data and model directories
mkdir -p /share/cortex-stt/models /data/audio

# Permissions
chown -R cortex-stt:cortex-stt /data /share/cortex-stt/models 2>/dev/null || true
