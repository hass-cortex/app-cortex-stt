#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Cortex STT Server — Init oneshot
# Pre-flight CPU check + dev-override + dirs + permissions
# ==============================================================================

# ------------------------------------------------------------------------------
# Pre-flight CPU feature check
#
# The bundled ggml kernels (transcribe.cpp, statically linked) are
# compiled for the x86-64-v3 baseline (GGML_NATIVE=OFF): AVX, AVX2,
# FMA, F16C, BMI2, SSE4.2. On an under-spec CPU the SIGILL happens
# deep inside inference with nothing useful for HA to log except a
# crash-loop, so we check *outside* the binary and refuse to start
# with a readable diagnostic instead.
#
# Read /proc/cpuinfo (always available in the addon container, even on
# masked KVM CPUs) and refuse to start with a readable diagnostic if
# any required feature is missing. Exit 78 (`EX_CONFIG`) so the finish
# script halts the container instead of looping forever.
# ------------------------------------------------------------------------------
REQUIRED_CPU_FLAGS=(avx avx2 fma f16c bmi2 sse4_2)
MISSING_CPU_FLAGS=()
for flag in "${REQUIRED_CPU_FLAGS[@]}"; do
    if ! grep -qw "${flag}" /proc/cpuinfo; then
        MISSING_CPU_FLAGS+=("${flag}")
    fi
done

if [ ${#MISSING_CPU_FLAGS[@]} -ne 0 ]; then
    bashio::log.fatal "============================================================"
    bashio::log.fatal "Cortex STT cannot start on this CPU."
    bashio::log.fatal ""
    bashio::log.fatal "Missing instruction set(s): ${MISSING_CPU_FLAGS[*]}"
    bashio::log.fatal "Required:                   ${REQUIRED_CPU_FLAGS[*]}"
    bashio::log.fatal ""
    bashio::log.fatal "The bundled ggml inference kernels are compiled for the"
    bashio::log.fatal "x86-64-v3 baseline and execute AVX2/FMA/F16C/BMI2"
    bashio::log.fatal "instructions during inference."
    bashio::log.fatal ""
    bashio::log.fatal "Running Home Assistant OS in Proxmox VE / KVM / libvirt?"
    bashio::log.fatal "  1. Open the HAOS VM's Hardware -> Processors -> Edit."
    bashio::log.fatal "  2. Change Type from 'kvm64' or 'x86-64-v2-AES' to"
    bashio::log.fatal "     'host' (recommended) or 'x86-64-v3'."
    bashio::log.fatal "  3. Fully shut down and start the VM. (Reboot is NOT"
    bashio::log.fatal "     enough — KVM only re-applies the CPU mask on a"
    bashio::log.fatal "     cold power-off + start.)"
    bashio::log.fatal ""
    bashio::log.fatal "Bare-metal pre-2013 CPU? This binary cannot run on it."
    bashio::log.fatal ""
    bashio::log.fatal "Full guide: https://github.com/hass-cortex/app-cortex-stt/blob/main/cortex-stt/DOCS.md#system-requirements"
    bashio::log.fatal "============================================================"
    exit 78  # EX_CONFIG — finish script halts the container, no crash-loop
fi

DEV_DIR="/share/.dev/cortex-stt"

if [ -d "${DEV_DIR}" ]; then
    if [ -f "${DEV_DIR}/cortex-stt" ]; then
        bashio::log.warning "[DEV MODE] Loading binary from ${DEV_DIR}"
        cp "${DEV_DIR}/cortex-stt" /app/cortex-stt
        chmod +x /app/cortex-stt
    fi

    if [ -d "${DEV_DIR}/web/dist" ]; then
        mkdir -p /app/web
        rm -rf /app/web/dist
        cp -r "${DEV_DIR}/web/dist" /app/web/dist
    fi
else
    bashio::log.info "Using baked-in binary at /app/cortex-stt"
fi

# Data and model directories — kept under /data so HA "Remove with data"
# can sweep them up. /share is no longer used; old /share/cortex-stt/models
# from <=0.1.4 stays behind on upgrade and must be removed manually.
mkdir -p /data/models /data/audio

# Ensure the Home Assistant discovery API key is set in the addon's options.
# Admins can rotate it from the app's Configuration tab — clearing the field
# causes this script to regenerate a fresh key on the next restart.
if ! bashio::config.has_value 'discovery_api_key'; then
    GENERATED_KEY="$(head -c 32 /dev/urandom | base64 | tr -d '=+/\n')"
    bashio::addon.option 'discovery_api_key' "${GENERATED_KEY}"
    bashio::addon.options > /data/options.json
    bashio::log.info "Generated bootstrap API key for Home Assistant discovery"
fi

# Permissions
chown -R cortex-stt:cortex-stt /data 2>/dev/null || true
